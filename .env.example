# URL de conexión a PostgreSQL (Neon u otra instancia).
# Ejemplo: postgresql://usuario:contraseña@host/db?sslmode=require
# Si usás Vercel Postgres, esta variable puede ser el valor de POSTGRES_URL (pooled).
DATABASE_URL=
# Alternativas de Vercel Postgres (el código las prueba en orden de fallback):
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=

# URL sin pooler para migraciones y drizzle-kit.
# Si usás Vercel Postgres, puede ser POSTGRES_URL_NON_POOLING.
DATABASE_URL_UNPOOLED=
# Alternativa de Vercel Postgres (fallback para drizzle-kit):
# POSTGRES_URL_NON_POOLING=

# URL base de la aplicación. En desarrollo suele ser http://localhost:3000.
# En producción debe coincidir exactamente con el dominio de Vercel.
# También se usa para construir URLs públicas de videos en modo local.
NEXTAUTH_URL=

# URL de autenticación para NextAuth v5 (opcional).
# Si se define, tiene prioridad sobre NEXTAUTH_URL. En producción debe coincidir
# con el dominio de Vercel; en desarrollo/tests suele ser http://localhost:3000.
# AUTH_URL=http://localhost:3000

# URL pública base de la aplicación (opcional).
# Si se define, tiene prioridad sobre NEXTAUTH_URL para construir URLs locales de videos,
# adjuntos de chat e imágenes de productos.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Host y puerto para el fallback de desarrollo de URLs públicas.
# Solo se usan si no hay NEXT_PUBLIC_APP_URL ni NEXTAUTH_URL. Por defecto: localhost:3000.
# HOST=localhost
# PORT=3000

# Secreto para firmar sesiones de NextAuth / Auth.js v5.
# Auth.js v5 prefiere AUTH_SECRET; si no está definida, se usa NEXTAUTH_SECRET
# como compatibilidad. Debe tener al menos 32 bytes.
# Generar con: npx auth secret  o  openssl rand -base64 32
# AUTH_SECRET=
NEXTAUTH_SECRET=

# Credenciales del administrador de la sucursal por defecto (obligatorias).
# El seed creará el usuario con la contraseña hasheada a partir de este valor.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Nombre de la sucursal por defecto.
# Esta sucursal recibirá los datos históricos existentes durante la migración.
DEFAULT_BRANCH_NAME=Sucursal por defecto

# Zona horaria para calcular horarios de apertura de sucursales (opcional).
# Si no se define, se usa America/Argentina/Buenos_Aires como fallback.
# NEXT_PUBLIC_BRANCH_TIMEZONE=America/Argentina/Buenos_Aires

# Opcional: credenciales para crear una segunda sucursal y usuario vía seed.
# Si están definidas, el seed creará idénticamente la sucursal y el usuario.
# NEW_BRANCH_NAME=
# NEW_BRANCH_USERNAME=
# NEW_BRANCH_PASSWORD=

# Proveedor de almacenamiento de intentos fallidos de login: memory (por defecto)
# o db (compartido en PostgreSQL). En producción con múltiples instancias se
# recomienda db. Requiere que DATABASE_URL o POSTGRES_URL estén definidas.
# Proveedor de almacenamiento de intentos fallidos de login:
# - memory: siempre en memoria (por defecto en desarrollo y test).
# - db:    en PostgreSQL (por defecto en producción si DATABASE_URL/POSTGRES_URL
#          está definida; configurable explícitamente con RATE_LIMIT_STORE_PROVIDER=db).
# RATE_LIMIT_STORE_PROVIDER=memory

# Intervalo de refresco del panel de caja en milisegundos.
# Si no se define, se usa el valor por defecto de 5000 ms.
NEXT_PUBLIC_CAJA_REFRESH_INTERVAL_MS=5000

# Horas de cierre automático de cajas abiertas (opcional).
# Si no se define, se cierran automáticamente después de 12 horas.
# CAJA_AUTO_CLOSE_HOURS=12
# NEXT_PUBLIC_CAJA_AUTO_CLOSE_HOURS=12

# Etiqueta del usuario que cierra cajas automáticamente (opcional).
# Si no se define, se usa 'Sistema'.
# CAJA_AUTO_CLOSED_BY=Sistema

# Intervalo del reloj de caja en milisegundos (opcional).
# Si no se define, se usa 60000 ms.
# NEXT_PUBLIC_CAJA_CLOCK_INTERVAL_MS=60000

# Días de historial de caja por defecto (opcional).
# Si no se define, se usa 30 días.
# CAJA_DEFAULT_HISTORY_DAYS=30
# NEXT_PUBLIC_CAJA_DEFAULT_HISTORY_DAYS=30

# Intervalo de refresco del catálogo público en milisegundos.
# Si no se define, se usa el valor por defecto de 30000 ms.
NEXT_PUBLIC_PEDIDO_REFETCH_INTERVAL_MS=30000

# Intervalo de refresco automático del listado de pedidos del operador en milisegundos.
# Si no se define, el auto-refresco está deshabilitado (0).
# Definir un valor mayor a 0 lo habilita; un valor entre 1 y 999 ms se ajusta a 10000 ms.
# Definir 0 lo deshabilita explícitamente.
# NEXT_PUBLIC_PEDIDOS_REFRESH_INTERVAL_MS=10000

# Timeout por defecto para solicitudes al API desde el cliente (milisegundos).
# Si no se define, se usa el valor por defecto de 30000 ms.
# NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Número de WhatsApp para pedidos (código de país completo, sin + ni espacios).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Saludo y cierre del mensaje de WhatsApp (opcionales).
# Si se dejan vacíos, el mensaje de WhatsApp se enviará sin saludo ni cierre.
NEXT_PUBLIC_WHATSAPP_MESSAGE_GREETING="Hola, quiero hacer el siguiente pedido:"
NEXT_PUBLIC_WHATSAPP_MESSAGE_CLOSING="Me confirmás el total y el medio de pago. Gracias."

# Expiración automática de pedidos pending en milisegundos (opcional).
# Si no se define, los pedidos expiran después de 1 hora (3600000 ms).
# Mínimo permitido: 60000 ms (1 minuto).
# La expiración se ejecuta al listar pedidos en el panel y solo limpia pedidos viejos.
# ORDER_EXPIRATION_MS=3600000

# Los cron jobs de limpieza se configuran en vercel.json (schedule hardcodeado).
# No se leen de variables de entorno. Ver CRON_SECRET para proteger los endpoints.

# Rate limiting para la creación pública de pedidos y del chat (opcionales).
# En producción con DATABASE_URL/POSTGRES_URL definidas, el proveedor por defecto
# es `db` (compartido en PostgreSQL); en desarrollo/test y sin base de datos
# disponible, `memory`. Forzar `memory` desactiva el store compartido.
# En desarrollo el rate limit de pedidos se desactiva por defecto para evitar
# bloqueos con la IP compartida de loopback (127.0.0.1 / ::1). Activar con:
# PUBLIC_ORDER_RATE_LIMIT_ENABLE_IN_DEV=true
# PUBLIC_ORDER_RATE_LIMIT_STORE_PROVIDER=memory
# PUBLIC_ORDER_RATE_LIMIT_WINDOW_MS=60000
# PUBLIC_ORDER_RATE_LIMIT_MAX_REQUESTS=10

# Header confiable para obtener la IP real del cliente en rate limiting.
# Si no se define, en producción se confía en el header de Vercel
# (x-vercel-forwarded-for) y en desarrollo se usa X-Forwarded-For como fallback.
# TRUSTED_PROXY_IP_HEADER=x-vercel-forwarded-for

# CRON_SECRET=tu_secreto_para_cron_jobs

# Configuración del chat de pedidos.
# NEXT_PUBLIC_CHAT_REFRESH_INTERVAL_MS=5000
# NEXT_PUBLIC_CHAT_MAX_TEXT_LENGTH=1000
# NEXT_PUBLIC_CHAT_PAGE_SIZE=50
# PUBLIC_CHAT_RATE_LIMIT_WINDOW_MS=60000
# PUBLIC_CHAT_RATE_LIMIT_MAX_REQUESTS=60
# NEXT_PUBLIC_CHAT_IMAGE_MAX_SIZE_MB=5
# NEXT_PUBLIC_CHAT_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# Configuración de videos y Cast.
NEXT_PUBLIC_CAST_RECEIVER_APP_ID=CC1AD845
NEXT_PUBLIC_CAST_SENDER_SDK_URL=https://www.gstatic.com/cv/js/sender/v1/cast_sender.js?loadCastFramework=1
# Tamaño máximo de video en MB (por defecto 100 MB).
# Si no se define, se usa el valor por defecto de 100 MB.
# NEXT_PUBLIC_VIDEO_MAX_SIZE_MB=100
NEXT_PUBLIC_VIDEO_ALLOWED_MIME_TYPES=video/mp4,video/webm,video/ogg

# Proveedor de almacenamiento para videos, adjuntos de chat e imágenes de productos: vercel-blob, s3, r2 o local.
# Por defecto se usa `local`. En producción se recomienda vercel-blob, s3 o r2.
# STORAGE_PROVIDER=vercel-blob

# Token de Vercel Blob, requerido si STORAGE_PROVIDER=vercel-blob.
# BLOB_READ_WRITE_TOKEN=

# Credenciales para S3.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=

# Credenciales para R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_REGION=

# Ruta local para almacenar videos, adjuntos de chat e imágenes de productos en desarrollo.
# Si no se define, se usa tmp/videos dentro del proyecto.
# LOCAL_STORAGE_PATH=

# Ruta local opcional solo para los adjuntos del chat.
# Si no se define, se usa LOCAL_STORAGE_PATH como fallback.
# CHAT_LOCAL_STORAGE_PATH=

# Configuración de imágenes ilustrativas de productos/promos.
# Tamaño máximo de imagen en MB (por defecto 5 MB).
# NEXT_PUBLIC_PRODUCT_IMAGE_MAX_SIZE_MB=5
# Tipos MIME de imagen permitidos separados por coma (por defecto image/jpeg,image/png,image/webp).
# NEXT_PUBLIC_PRODUCT_IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# Ruta local opcional para las imágenes de productos; si no se define, usa LOCAL_STORAGE_PATH como fallback.
# PRODUCT_IMAGE_LOCAL_STORAGE_PATH=
# Lista opcional de dominios permitidos para URLs externas de imágenes, separados por coma.
# Si no se define, se aceptan todos los dominios HTTPS.
# PRODUCT_IMAGE_ALLOWED_EXTERNAL_DOMAINS=
# Longitud máxima de una URL externa de imagen (por defecto 2048).
# NEXT_PUBLIC_PRODUCT_IMAGE_URL_MAX_LENGTH tiene prioridad; si no está, se lee PRODUCT_IMAGE_URL_MAX_LENGTH.
# NEXT_PUBLIC_PRODUCT_IMAGE_URL_MAX_LENGTH=2048
# PRODUCT_IMAGE_URL_MAX_LENGTH=2048

# Valores de los botones de denominación rápida en el ingreso de pagos (opcional).
# Lista de montos enteros separados por coma. Por defecto: 1000,2000,5000,10000,20000.
# NEXT_PUBLIC_PAYMENT_DENOMINATIONS=1000,2000,5000,10000,20000

# Variables para tests E2E. Ver .env.e2e.example para la plantilla completa.
# .env.e2e tiene prioridad sobre .env.local; usalo para apuntar a una base
# descartable cuyo nombre termine en test/e2e/qa/staging y mantener .env.local
# con el entorno de desarrollo. NUNCA uses una base de producción para E2E.

# Habilitar Vercel Web Analytics.
# Si se define como `true`, se inyecta el script de analytics en todas las páginas.
# En desarrollo no envía datos aunque esté habilitado. También es necesario
# activar Web Analytics desde el dashboard de Vercel para que se recolecten eventos.
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=true
