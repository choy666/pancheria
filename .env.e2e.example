# Variables de entorno para los tests E2E.
# Copiar este archivo a .env.e2e y completar DATABASE_URL con una base descartable.
# .env.e2e tiene prioridad sobre .env.local para mantener el entorno de tests
# aislado del entorno de desarrollo.
# NUNCA uses una base de datos de producción para E2E; global-setup.ts trunca tablas.

# URL de conexión a PostgreSQL para E2E. Debe apuntar a una base descartable.
# Ejemplo local: postgresql://postgres:postgres@localhost:5432/pancheria_e2e
DATABASE_URL=

# URL sin pooler para migraciones de drizzle-kit en E2E, si aplica.
# Si no se define, drizzle.config.ts usará DATABASE_URL como fallback.
# DATABASE_URL_UNPOOLED=

# URLs y entorno de ejecución.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000
NODE_ENV=test

# Secreto de autenticación (obligatorio). Auth.js v5 prefiere AUTH_SECRET;
# si no está definida, se usa NEXTAUTH_SECRET como compatibilidad.
# En CI se espera como repository secret. No uses un valor corto o predecible.
# AUTH_SECRET=
NEXTAUTH_SECRET=

# Rate limiting en memoria para no depender de PostgreSQL compartido.
RATE_LIMIT_STORE_PROVIDER=memory

# Almacenamiento local aislado para E2E.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=tmp/e2e

# Nombre de la sucursal por defecto. Debe coincidir con DEFAULT_BRANCH_NAME en
# .env.local si se usa el mismo seed.
DEFAULT_BRANCH_NAME=Sucursal E2E

# Refresco del chat más rápido para E2E.
NEXT_PUBLIC_CHAT_REFRESH_INTERVAL_MS=1000

# Proveedor de rate limit en memoria para pedidos y chat públicos.
PUBLIC_ORDER_RATE_LIMIT_STORE_PROVIDER=memory

# Credenciales de admin para E2E (obligatorias). Deben coincidir con el usuario
# que crea src/db/seeds.ts; de lo contrario los tests de login fallarán.
# En CI se esperan como repository secrets.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Permitir bases de datos remotas no detectadas como descartables.
# Solo activar si estás completamente seguro del destino.
# E2E_ALLOW_REMOTE_DB=true
